{
  "name": "astro-jsx",
  "version": "0.0.1",
  "type": "module",
  "description": "Astro-compatible server-only JSX/TSX runtime with SSR renderer",
  "sideEffects": false,
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:types": "tsc --noEmit --project tests/types/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration/*.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm typecheck && pnpm typecheck:types && pnpm test && pnpm test:coverage",
    "knip": "knip"
  },
  "keywords": ["astro", "jsx", "tsx", "ssr", "server-rendering"],
  "author": "jp-knj",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/jsx-runtime.d.ts",
      "import": "./dist/runtime/jsx-runtime.js",
      "default": "./dist/runtime/jsx-runtime.js"
    },
    "./runtime/delegate": {
      "types": "./dist/runtime/actions/index.d.ts",
      "import": "./dist/runtime/actions/index.js",
      "default": "./dist/runtime/actions/index.js"
    },
    "./runtime/jsx-runtime": {
      "types": "./dist/runtime/jsx-runtime.d.ts",
      "import": "./dist/runtime/jsx-runtime.js",
      "default": "./dist/runtime/jsx-runtime.js"
    },
    "./runtime/jsx-dev-runtime": {
      "types": "./dist/runtime/jsx-dev-runtime.d.ts",
      "import": "./dist/runtime/jsx-dev-runtime.js",
      "default": "./dist/runtime/jsx-dev-runtime.js"
    },
    "./render/renderer": {
      "types": "./dist/render/renderer.d.ts",
      "import": "./dist/render/renderer.js",
      "default": "./dist/render/renderer.js"
    },
    "./render/manifest": {
      "types": "./dist/render/manifest.d.ts",
      "import": "./dist/render/manifest.js",
      "default": "./dist/render/manifest.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "default": "./dist/plugin/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "runtime": ["dist/runtime/jsx-runtime.d.ts"],
      "runtime/delegate": ["dist/runtime/actions/index.d.ts"],
      "runtime/jsx-runtime": ["dist/runtime/jsx-runtime.d.ts"],
      "runtime/jsx-dev-runtime": ["dist/runtime/jsx-dev-runtime.d.ts"],
      "render/renderer": ["dist/render/renderer.d.ts"],
      "render/manifest": ["dist/render/manifest.d.ts"],
      "plugin": ["dist/plugin/index.d.ts"]
    }
  },
  "dependencies": {
    "escape-html": "1.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/escape-html": "1.0.4",
    "@types/node": "20.11.5",
    "@vitest/coverage-v8": "^1.6.0",
    "astro": "^5.0.0",
    "knip": "5.64.3",
    "typescript": "5.3.3",
    "vitest": "^1.6.0"
  },
  "peerDependencies": {
    "astro": ">=4.0.0"
  },
  "engines": {
    "node": ">=18.14.1"
  }
}
