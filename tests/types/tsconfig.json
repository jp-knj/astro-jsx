{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "astro-jsx/runtime",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "astro-jsx": ["../../src/index.ts"],
      "astro-jsx/*": ["../../src/*"]
    }
  },
  "include": ["attributes.ts"],
  "exclude": ["../../dist"]
}
