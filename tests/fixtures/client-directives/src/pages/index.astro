<html lang="en">
  <head>
    <title>Client Directive Coverage</title>
  </head>
  <body>
    <main>
      <h1>Supported client directives</h1>
      <section client:load>
        <h2>client:load island</h2>
      </section>
      <section client:idle>
        <h2>client:idle island</h2>
      </section>
      <section client:visible>
        <h2>client:visible island</h2>
      </section>
      <section client:media="(max-width: 600px)">
        <h2>client:media island</h2>
      </section>
    </main>
  </body>
</html>
